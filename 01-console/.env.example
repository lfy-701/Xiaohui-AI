# 控制台服务端配置示例
# 复制为 .env 后按需修改；.env 不会进仓库

# ---------- 访问与鉴权 ----------
# 控制台登录密码，留空则不启用登录
CONSOLE_PASSWORD=
# 设备接入令牌，必须与固件中的 CONSOLE_DEVICE_TOKEN 一致
DEVICE_TOKEN=

# ---------- 内部服务地址 ----------
# 知识库/记忆服务
KB_URL=http://127.0.0.1:8077
# 音乐 MCP 服务（本机或局域网）
MUSIC_BASE_URL=http://127.0.0.1:8102

# ---------- 模型服务 ----------
# 模型服务地址（OpenAI 兼容），用于控制台「试聊」
LLM_CHAT_URL=http://127.0.0.1:8000/v1/chat/completions
LLM_API_KEY=
LLM_PROVIDER=openai
# 模型服务里的 MCP 管理接口，留空则 MCP 页签显示未配置
MCP_BASE_URL=
# 远程写操作令牌，只存在后端，绝不返回浏览器
MCP_ADMIN_TOKEN=

# ---------- 语音服务端 ----------
# 设备 OTA 会拿到这个地址；填语音服务实际监听的地址
WS_URL=ws://127.0.0.1:8000/xiaozhi/v1/
WS_TOKEN=

# ---------- 数据目录 ----------
FIRMWARE_DIR=./data/firmware
MUSIC_LIBRARY_DIR=./data/music
