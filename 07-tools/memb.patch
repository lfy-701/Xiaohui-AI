-            resp["websocket"] = {"url": WS_URL, "token": WS_TOKEN, "version": 1}
+            resp["websocket"] = {"url": _ws_url_for(request), "token": WS_TOKEN, "version": 1}
         else:
             store.add_log("system", "警告：已绑定设备但未配置 WS_URL，设备将无法对话")
 
