# =====================================================================
# 小慧大模型专区 · 独立部署配置
# 只改这个文件；不要动现有小慧控制台的 console.db / 8000 / 8009
# =====================================================================

# 独立进程监听 8013；只允许 Tailscale/局域网访问，不要直接暴露公网
APP_HOST=
APP_PORT=
LOG_LEVEL=

# DeepSeek 云端 API（密钥只保存在这台机器的 .env）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# 深度思考默认关闭，按请求开启
DOG_THINKING_ENABLED=
DOG_REASONING_EFFORT=
DEEPSEEK_TIMEOUT_S=
DEEPSEEK_TOTAL_TIMEOUT_S=
DEEPSEEK_MAX_RETRIES=

DOG_MAX_TOKENS=
DOG_MAX_TOKENS_THINKING=
DOG_MAX_REASONING_CHARS=
DOG_TEMPERATURE=
DOG_MAX_MESSAGE_CHARS=
DOG_MAX_HISTORY_MESSAGES=

# 控制台访问令牌，安装脚本会自动生成；至少 16 位
CONSOLE_TOKEN=
DOG_SYSTEM_PROMPT=
